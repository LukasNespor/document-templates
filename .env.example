# Azure Storage Configuration
# Get these values from your Azure Storage Account

# Connection string for Azure Storage (used for Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net

# Azure Storage Account Name (used for Table Storage)
AZURE_STORAGE_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# Azure Storage Account Key (used for Table Storage)
AZURE_STORAGE_ACCOUNT_KEY=YOUR_ACCOUNT_KEY

# Authentication Configuration
# Session secret for encrypting session cookies
# IMPORTANT: Generate a random string of at least 32 characters for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=complex_password_at_least_32_characters_long_change_this

# AI-generated field display names (optional, disabled by default)
# When set to "true", the context around each {{field}} placeholder is sent to
# Azure OpenAI to build human readable form labels. Any other value keeps the
# feature off and no data leaves the application. Enable only if the Azure OpenAI
# resource has modified abuse monitoring approved, otherwise prompts are retained
# by Microsoft for up to 30 days.
AI_FIELD_NAMES_ENABLED=false

# Azure OpenAI Configuration (only used when AI_FIELD_NAMES_ENABLED=true)
# Get these values from your Azure OpenAI resource
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_API_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
